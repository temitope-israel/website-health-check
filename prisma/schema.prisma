generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Lead {
  id            Int      @id @default(autoincrement())
  email         String
  url           String
  performance   Int
  seo           Int
  accessibility Int
  bestPractices Int
  createdAt     DateTime @default(now())
}